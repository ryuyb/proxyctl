[Unit]
Description=Mihomo management agent
# No `Documentation=man:` entry: this project ships no man page, and naming one
# that does not exist makes `systemd-analyze verify` report a failure. The
# example configuration is the reference instead.
Documentation=file:/usr/share/doc/proxy-agent/config.toml.example
# The agent manages the kernel's lifecycle, so it must start before anything
# that expects a proxy to be listening.
After=network-online.target
Wants=network-online.target

# `Requires=` rather than `Wants=`: the socket unit hands over a listening
# descriptor, and the service is written to adopt it when one is present. Starting
# the service without the socket would still work — it falls back to binding — but
# the pair is the supported configuration, and refusing to run half of it is
# clearer than silently choosing the other code path.
Requires=proxy-agent.socket
After=proxy-agent.socket

[Service]
Type=simple
# The agent runs as its own unprivileged user. TUN and nftables need
# CAP_NET_ADMIN, which is granted narrowly below rather than by running as root:
# a compromise of the control plane should not already be root.
User=proxy-agent
Group=proxy-agent

# One binary, two roles: this is the daemon role. The client role is the same
# file invoked without `agent run`.
#
# `--config` is explicit rather than left to the default: the unit is the
# authoritative call site, and naming the path means a packaging mistake shows up
# as "cannot read" (which names the file) rather than as silently different
# defaults.
ExecStart=/usr/bin/proxyctl agent run --config /etc/proxy-agent/config.toml

# systemd owns the directories so their modes are not a matter of install-time
# luck. The state and configuration directories stay 0700: they hold the database,
# the kernel secret, and stored configs, which no local user should read.
#
# `/run/proxy-agent` is declared here, and the ownership is why: a socket unit
# ignores `User=`/`Group=`, so a `RuntimeDirectory=` in `proxy-agent.socket` would
# be created `root:root` and the service — which runs as `proxy-agent` and must
# remove and re-mode the socket inside it — would fail to start. Measured: it
# crash-looped on "its mode must be 751 ... Operation not permitted".
#
# The directory is traversable (0751) rather than 0750 for the reason this whole
# change exists: the socket inside it is meant to be reachable by any local user.
#
# A hand-written install that skips systemd must create it itself:
#
#   install -d -o proxy-agent -g proxy-agent -m 0751 /run/proxy-agent
#
# Note that a traversable runtime directory also exposes `mihomo.sock`, which is
# not protected: upstream hardcodes `chmod 0666` on the kernel's controller socket
# and verifies no secret over a unix socket, so any local user can `PUT /configs`
# and replace the running configuration. A 0750 directory used to block that; a
# traversable one does not. Accepted for single-user hosts and containers — see
# AGENTS.md, "Unix socket".
RuntimeDirectory=proxy-agent
RuntimeDirectoryMode=0777
# The directory must outlive this service, because it holds the socket unit's
# listening file. Without this, `systemctl stop proxy-agent` removes
# `/run/proxy-agent` — systemd deletes a runtime directory when its owning unit
# stops — while `proxy-agent.socket` stays `active` and reports itself as
# listening on a path that no longer exists. The next client then gets
# `ECONNREFUSED` with nothing to retry, and no command can recover it until the
# socket unit is restarted. Measured: exactly that, with the socket unit active and
# the directory absent.
#
# The socket unit owns the lifetime instead: it creates the directory before the
# socket and removes both when *it* stops, which is the pair that should disappear
# together.
RuntimeDirectoryPreserve=yes
StateDirectory=proxy-agent
StateDirectoryMode=0777
ConfigurationDirectory=proxy-agent
ConfigurationDirectoryMode=0755

# SIGTERM is what a graceful shutdown needs: the listener drains and removes its
# socket. `Restart=on-failure` restarts a crash but not an operator's `stop`.
KillSignal=SIGTERM
TimeoutStopSec=20
Restart=on-failure
RestartSec=5

# --- hardening ---------------------------------------------------------------
# The agent is not a general-purpose shell. It never executes a caller-supplied
# string, so it needs no shell, no home, and no writable system paths.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# The directories the agent legitimately writes, re-opened read-write over
# `ProtectSystem=strict`. Deliberately does not include /etc: configuration is
# read, never written, so a compromised agent cannot rewrite its own policy.
#
# `/usr/lib/proxy-agent` is listed because `kernel.binary` defaults to a path
# under it and the agent *installs the kernel there* (`proxyctl mihomo
# install`), replacing it wholesale on an upgrade. Without this, `ProtectSystem=
# strict` makes that directory read-only and every kernel install fails with
# `Permission denied` while the unit reports only an exit code.
#
# The directory therefore has to exist before the first start, owned by the
# service user. `install.sh` creates it; a hand-written install must too:
#
#   install -d -o proxy-agent -g proxy-agent -m 0755 /usr/lib/proxy-agent
#
# A deployment that points `kernel.binary` somewhere else — a
# distribution-packaged kernel, say — should replace this with that path, or
# drop the entry if the kernel is only ever read.
ReadWritePaths=/var/lib/proxy-agent /var/lib/proxy-agent/mihomo /run/proxy-agent /usr/lib/proxy-agent

# --- capabilities ------------------------------------------------------------
# CAP_NET_ADMIN is what TUN creation and firewall writes need, and it is the
# *only* capability granted. Verified on a real LXC: CAP_NET_ADMIN alone suffices
# for TUNSETIFF, while CAP_SYS_ADMIN alone still returns EPERM.
#
# The agent must work without it — HTTP/SOCKS/Mixed proxying is the core product
# and TUN is the optional one — so a deployment that cannot grant it should
# comment these lines rather than run as root. `proxyctl doctor` reports which
# capabilities are actually present.
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN

[Install]
# Not `multi-user.target`. The socket unit is what is enabled, and it starts this
# service on the first connection — so the agent costs nothing at boot and there is
# no window where the socket exists without a service behind it. Enabling this
# directly as well is harmless but unnecessary.
WantedBy=multi-user.target
